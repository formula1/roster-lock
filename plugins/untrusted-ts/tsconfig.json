{
  "compilerOptions": {
    "target": "es2024",
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "types": [],
    "lib": ["es2024", "dom"],
    "sourceMap": true,
    "rootDir": "./src",
    "outDir": "./dist",
    "esModuleInterop": true,
    "strict": true,
    "skipLibCheck": true,
    "removeComments": true,
    "noImplicitAny": true
  },
  "files": ["src/index.ts"],
  "include": ["./typings", "./types", "**/*.test.ts"],
  "exclude": ["node_modules", "**/*.spec.ts"]
}
