; Definition of stage 0 (training stage), storm variant.
; Base stage (camera, bounds, floor/wall sprites) is unchanged Elecbyte
; Training Room. What's new is a rain layer and a lightning flash, both
; built from original hand-drawn sprites (see readme.txt) driven entirely
; by native stage.def features - [BG] velocity/sin.x and [BGCtrl] Visible
; scheduling. No character code is involved (stages can't run any).
; *** denotes values you should change/check for each stage.
; The term "background" is used to mean both backgrounds and foregrounds.

;--------------------------------------------------------
[Info]
 ;Name of the stage.
name = "Training Room (Storm)"
displayname = "Training Room (Storm)" ;Name to display
versiondate = 09,30,2009    ;Version date of stage (MM,DD,YYYY or X.XX)
mugenversion = 1.0          ;Version of M.U.G.E.N stage works on (X.XX)
author = "Elecbyte"         ;Stage author name (base stage; see readme.txt)

;--------------------------------------------------------
[Camera]
 ;Camera starting position: Usually 0 for both
startx = 0
starty = 0

 ;Left and right bound of camera
 ;You may want to fiddle a bit with these values to make sure the
 ;background doesn't move too far or too little
 ;***
boundleft = -125
boundright = 125

 ;High and low bound of camera
 ;High is a negative number. Make is more negative if you want to
 ;camera to be able to move higher.
 ;Low should usually be 0.
 ;If omitted, defaults to -25 and 0 respectively
 ;***
boundhigh = -25
boundlow = 0

 ;This is how much the camera will move vertically towards the
 ;highest player. Valid values are from 0 to 1. A value of 0 will mean
 ;the camera does not move up at all. A value of 1 will makes the camera
 ;follow the highest player.
 ;Typically .2 for normal-sized backgrounds. You may need to pull this
 ;value up for taller backgrounds.
verticalfollow = .2

 ;Minimum vertical distance the highest player has to be from the floor,
 ;before the camera starts to move up to follow him. For extremely
 ;tall stages, a floor tension of about 20-30 coupled with a
 ;vertical-follow of .8 allows the camera to follow the action.
floortension = 0

 ;Horizontal distance player is from edge before camera starts to move
 ;left or right. Typically 50 or 60.
tension = 50

 ;Number of pixels beyond the top and bottom of the screen that may
 ;be drawn.  Overdraw specifies the how much can be seen during an
 ;EnvShake.  Overdraw pixels will also be used when the screen aspect
 ;is taller than the stage aspect.
overdrawhigh = 0
overdrawlow = 0

 ;Number of pixels into the top and bottom of the screen that may be
 ;cut from drawing when the screen aspect is shorter than the stage
 ;aspect.  These parameters suggest a guideline, and the actual
 ;number of pixels cut depends on the difference in aspect.
cuthigh = 35
cutlow = 25


;--------------------------------------------------------
[PlayerInfo]
;--- Player 1 ---
 ;Player 1 starting coordinates.
 ;p1startx is typically -70 and p2startx is 70.
 ;p1starty should be 0.
p1startx = -70          ;Starting x coordinates
p1starty = 0            ;Starting y coordinates
p1facing = 1            ;Direction player faces: 1=right, -1=left

;--- Player 2 ---
p2startx = 70
p2starty = 0
p2facing = -1

;--- Common ---
 ;Don't change these values.
leftbound  = -1000 ;Left bound (x-movement)
rightbound =  1000 ;Right bound

;--------------------------------------------------------
[Bound]
 ;Distance from left/right edge of screen that player can move to
 ;Typically 15
screenleft = 15    ;Dist from left of screen that player can move to
screenright = 15   ;Right edge

;--------------------------------------------------------
[StageInfo]
 ;"Ground" level where players stand at, measured in pixels from the
 ;top of the screen.
 ;Adjust this value to move the ground level up/down in the screen.
 ;***
zoffset = 190

 ;Leave this at 1. It makes the players face each other
autoturn = 1

 ;Set the following to 1 to have the background reset itself between
 ;rounds.
resetBG = 1

 ;Width and height of the local coordinate space of the stage.
localcoord = 320, 240

 ;Horizontal and vertical scaling factor for drawing.
xscale = 1
yscale = 1

;--------------------------------------------------------
[Shadow]
 ;This is the shadow darkening intensity. Valid values range from
 ;0 (lightest) to 256 (darkest). Defaults to 128 if omitted.
intensity = 96

 ;This is the shadow color given in r,g,b. Valid values for each
 ;range from 0 (lightest) to 255 (darkest).
 ;Defaults to 0,0,0 if omitted.
 ;intensity and color's effects add up to give the final shadow
 ;result.
color = 0,0,0

 ;This is the scale factor of the shadow. Use a big scale factor
 ;to make the shadow longer. You can use a NEGATIVE scale factor
 ;to make the shadow fall INTO the screen.
 ;Defaults to 0.4 if omitted.
yscale = .3

 ;This parameter lets you set the range over which the shadow is
 ;visible. The first value is the high level, and the second is
 ;the middle level. Both represent y-coordinates of the player.
 ;A shadow is invisible if the player is above the high level,
 ;and fully visible if below the middle level. The shadow is
 ;faded in between the two levels. This gives an effect of the
 ;shadow fading away as the player gets farther away from the
 ;ground. If omitted, defaults to no level effects (shadow is
 ;always fully visible).
fade.range = 0,0

;--------------------------------------------------------
[Reflection]
 ;Intensity of reflection (from 0 to 256). Set to 0 to have no
 ;reflection. Defaults to 0.
intensity = 0

;--------------------------------------------------------
[Music]
 ;Put a filename for a MOD, MP3 or MIDI here, or just leave it
 ;blank if you don't want music. If an invalid filename is
 ;given, then no music will play. To play CD audio, put
 ;the track number followed by ".da". Using a track number of
 ;0 will play a random audio track. For example, to play
 ;track 3 from a music CD, use:
 ;  bgmusic = 3.da
bgmusic =

;bgmloopstart = <sample number>
;bgmloopend = <sample number>

 ;Adjust the volume. 100 is for 100%.
bgmvolume = 100

;========================================================
;--------------------------------------------------------
; Background definition
; ***
;-------------------------------------
[BGdef]
 ;Filename of sprite data
spr = stage0_storm.sff

 ;Set to 1 if you want to clear the screen to magenta before
 ;drawing layer 0 (the default background). Good for spotting "holes"
 ;in your background.
 ;Remember to turn this off when you are done debugging the background,
 ;because it slows down performance.
debugbg = 0

;-------------------------------------
; IKEMEN GO ONLY, preview animation used in the Select screen
[Begin Action 9000]
9000,1, 0,0,-1
;-------------------------------------

;----------
; Floor
[BG 0]
type  = normal
spriteno = 0, 0
layerno = 0
start = 0, 0
delta = 1, 1
mask  = 0
velocity = 0, 0
tile  = 1, 0
tilespacing = 0,0

;----------
; Wall
[BG 1]
type  = normal
spriteno = 0, 1
start = 0, 185
delta = 1, 1
mask = 0
velocity = 0, 0
tile = 1, 0
tilespacing = 0, 0

;==========================================================
; Storm layer
;
; Both sprites below (group 500) are new, hand-drawn additions appended
; onto the unmodified stage0.sff via a small SFF v2 append tool - see
; readme.txt. Everything driving them (velocity, sin.x, BGCtrl Visible
; scheduling) is documented, native MUGEN/Ikemen stage.def functionality;
; stages can't run character code, so there's no PalFX-style controller
; available here, which is why the flash is a toggled additive sprite
; rather than a screen-wide palette effect.
;==========================================================

;----------
; Rain: a 32x64 tileable streak texture, tiled infinitely and dropped
; straight down the screen at a slant that matches the streaks' own
; drawn angle, with a slow side-to-side sin.x sway layered on top for a
; gusting-wind feel. Foreground layer so it reads clearly over players.
[BG Rain]
type = normal
spriteno = 500, 0
id = 1
layerno = 1
start = 0, 0
delta = 0, 0
; mask = 1 is required, not optional, for a real-alpha RGBA sprite: Ikemen's
; sprite.frag.glsl forces c.a = 1.0 (fully opaque) whenever mask is off,
; for both indexed and truecolor sprites alike. mask = 0 here silently
; turned the whole tile into an opaque black rectangle.
mask = 1
trans = none
velocity = 1, 6
sin.x = 6, 200, 0
tile = 1, 1
tilespacing = 0, 0

;----------
; Lightning flash: a full-screen (320x240) sprite, invisible by default,
; drawn additively so it brightens the scene instead of covering it, and
; toggled on for a couple of short double-flash bursts per loop by the
; BGCtrlDef below.
[BG Flash]
type = normal
spriteno = 500, 1
id = 2
layerno = 1
; The sprite's axis is its top-left corner (0,0), and x=0 in stage space is
; screen-center, not the left edge - start=0,0 would anchor the image's
; left edge at center, pushing the right half off-screen. Shifting by
; -160 (half the sprite's own 320px width) re-centers it.
start = -160, 0
delta = 0, 0
mask = 0
trans = add
alpha = 170, 256
tile = 0, 0

;----------
; Lightning schedule: silent for ~4.3s, a quick double-flash, silent for
; ~3.4s, repeating every 480 ticks (8s at 60fps). Every tick in the loop
; is covered by an explicit On/Off window (no gaps) so the schedule is
; correct regardless of whether Visible auto-reverts after its window or
; latches until the next controller - see the docs' own wording ("the
; controller will be continuously active between START_TIME and
; END_TIME") which doesn't fully pin down which one MUGEN does.
[BGCtrlDef Storm]
looptime = 480
ctrlID = 2

[BGCtrl Flash Off Lead-in]
type = Visible
time = 0, 259
value = 0

[BGCtrl Flash Burst 1]
type = Visible
time = 260, 265
value = 1

[BGCtrl Flash Gap]
type = Visible
time = 266, 271
value = 0

[BGCtrl Flash Burst 2]
type = Visible
time = 272, 275
value = 1

[BGCtrl Flash Off Tail]
type = Visible
time = 276, 479
value = 0
