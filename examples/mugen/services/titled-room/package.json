{
  "name": "@roster-lock/titled-room",
  "version": "0.0.0",
  "private": true,
  "description": "Cloudflare Worker titled-room matchmaker service for roster-lock",
  "keywords": ["roster-lock", "matchmaker", "titled-room", "cloudflare-worker"],
  "license": "JSON",
  "author": "Sam Tobia",
  "type": "commonjs",
  "main": "dist/index.js",
  "types": "src/index.ts",
  "scripts": {
    "dev": "pnpm run build:client && wrangler dev",
    "dev:client": "pnpm --filter @roster-lock/titled-room-client run dev",
    "dev:client:watch": "pnpm --filter @roster-lock/titled-room-client run build -- --watch",
    "build": "tsc && pnpm run build:client",
    "build:client": "pnpm --filter @roster-lock/titled-room-client run build",
    "deploy": "pnpm run build:client && wrangler deploy",
    "test": "vitest run"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20260103.0",
    "@types/node": "^22.14.1",
    "typescript": "^7.0.2",
    "vitest": "^4.1.5",
    "wrangler": "^4.110.0"
  },
  "dependencies": {
    "@roster-lock/game-launcher-ikemen-go": "workspace:*",
    "@roster-lock/types": "workspace:*",
    "@roster-lock/utils": "workspace:*",
    "hono": "^4.11.3",
    "zod": "^4.3.5"
  }
}
