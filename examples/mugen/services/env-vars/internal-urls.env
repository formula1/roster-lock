RELAY_SERVER_URL=http://relay-room:80
PUBLIC_RELAY_SERVER_URL=http://localhost:7443

AUTH_SERVICE_URL=http://auth-naive:80
PUBLIC_AUTH_SERVICE_URL=http://localhost:7444

PUBLIC_TITLED_ROOM_URL=http://localhost:7445

IKEMEN_COORDINATOR_WEBHOOK_URL=http://direct-ip-coordinator:80
PUBLIC_IKEMEN_COORDINATOR_HTTP_URL=http://localhost:7446
# The rendezvous TCP port ikemen-go's plugin (running on the host, alongside
# match-agent) actually dials - see plugins/game-launcher/ikemen-go/src/coordinator.
# Read directly by titled-room itself now (see its game-launchers.ts
# gameCoordinatorFor) as well as by the integration script.
IKEMEN_COORDINATOR_TCP_HOST=localhost
IKEMEN_COORDINATOR_TCP_PORT=9010
# Also read directly by titled-room (gameCoordinatorFor) and used to register
# this coordinator with relay-room (setupServers.ts).
GAME_COORDINATOR_ID=ikemen-coordinator-1
