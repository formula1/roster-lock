
# Read by the integration script (not by any service directly) when
# registering ikemen-go with titled-room's admin API
# (PUT /admin/game-launchers/:pluginName) and with relay-room's admin API
# (game coordinator registration) - see setupServers.ts.

# Matches plugins/game-launcher/ikemen-go/src/engineConfig.ts's IKEMEN_ENGINE_SHA
# (kept in sync by that package's own test/engineConfig.test.ts, not by this
# file importing it - see engineConfig.ts's comment).
IKEMEN_ENGINE_SHA=cb2badbe0d7f9b9f52e18b52239a18aaafdad9405472e6108ec1bf1eb27f9f25

GAME_COORDINATOR_ID=ikemen-coordinator-1

# titled-room's own admin login (see its wrangler.toml's INITIAL_ADMIN_USERNAME/
# PASSWORD defaults) - separate from any regular user account.
TITLED_ROOM_ADMIN_USERNAME=hello
TITLED_ROOM_ADMIN_PASSWORD=world
