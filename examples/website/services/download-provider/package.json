{
  "name": "@roster-lock/website-download-provider",
  "version": "0.0.0",
  "private": true,
  "description": "Cloudflare Worker that accepts, validates, and serves uploaded roster-lock pieces for the website game example",
  "license": "JSON",
  "author": "Sam Tobia",
  "type": "commonjs",
  "main": "dist/index.js",
  "types": "src/index.ts",
  "scripts": {
    "dev": "wrangler dev",
    "build": "tsc --noEmit",
    "deploy": "wrangler deploy",
    "deploy:production": "wrangler deploy --env production",
    "types": "wrangler types",
    "test": "vitest run"
  },
  "dependencies": {
    "@roster-lock/dl-archive-tar": "workspace:*",
    "@roster-lock/shared": "workspace:*",
    "@roster-lock/types": "workspace:*",
    "@roster-lock/utils": "workspace:*",
    "@roster-lock/website-auth": "workspace:*",
    "@roster-lock/website-db": "workspace:*",
    "acorn": "^8.15.0",
    "acorn-jsx": "^5.3.2",
    "aws4fetch": "^1.0.20",
    "fast-xml-parser": "^5.2.5",
    "hono": "^4.11.3",
    "json5": "^2.2.3",
    "zod": "^4.3.5"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20260103.0",
    "@types/node": "^22.14.1",
    "rimraf": "^6.1.3",
    "tar": "^7.5.2",
    "typescript": "^7.0.2",
    "vitest": "^4.1.5",
    "wrangler": "^4.110.0"
  }
