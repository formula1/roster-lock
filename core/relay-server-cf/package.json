{
  "name": "@roster-lock/relay-server",
  "version": "0.0.0",
  "private": true,
  "description": "To be used to connect multiple clients",
  "keywords": [
    "roster-lock",
    "game"
  ],
  "homepage": "https://github.com/formula1/roster-lock#readme",
  "bugs": {
    "url": "https://github.com/formula1/roster-lock/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/formula1/roster-lock.git"
  },
  "license": "JSON",
  "author": "Sam Tobia",
  "type": "commonjs",
  "main": "dist/index.js",
  "types": "src/index.ts",
  "scripts": {
    "dev": "pnpm run build:client && wrangler dev",
    "dev:client": "cd client && pnpm run dev",
    "dev:client:watch": "cd client && pnpm run build -- --watch",
    "build": "pnpm run build:client",
    "build:client": "cd client && pnpm run build",
    "deploy": "pnpm run build:client && wrangler deploy",
    "deploy:production": "pnpm run build:client && wrangler deploy --env production",
    "tail": "wrangler tail",
    "types": "wrangler types",
    "test": "vitest run"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20260103.0",
    "@types/express": "^5.0.6",
    "@types/node": "^22.14.1",
    "rimraf": "^6.0.1",
    "typescript": "^7.0.2",
    "vitest": "^4.1.5",
    "wrangler": "^4.110.0"
  },
  "dependencies": {
    "@roster-lock/utils": "workspace:*",
    "hono": "^4.11.3",
    "zod": "^4.3.5"
  }
}
