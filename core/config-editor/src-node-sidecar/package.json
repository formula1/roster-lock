{
  "name": "config-editor-sidecar",
  "version": "1.0.0",
  "main": "dist/index.js",
  "scripts": {
    "prepare": "pnpm run build",
    "build": "pnpm run build:ts && pnpm run build:pkg",
    "build:ts": "rimraf ./dist && tsc",
    "build:pkg": "node scripts/build-sidecar.js",
    "dev": "tsx src/index.ts",
    "start": "node dist/index.js"
  },
  "dependencies": {
    "@roster-lock/plugin-runtime": "workspace:*",
    "commander": "^11.1.0",
    "zod": "^4.3.5"
  },
  "devDependencies": {
    "@types/node": "^20.19.27",
    "@yao-pkg/pkg": "^6.19.0",
    "rimraf": "^6.1.3",
    "tsx": "^4.0.0",
    "typescript": "^5.0.0"
  }
}
