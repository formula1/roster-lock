{
  "name": "@roster-lock/config-editor",
  "private": true,
  "version": "0.0.0",
  "type": "commonjs",
  "scripts": {
    "dev": "./dev.sh",
    "dev:vite": "vite",
    "dev:tauri": "cargo tauri dev",
    "dev:simple": "run-p dev:vite dev:watch",
    "dev:watch": "sleep 4 && echo '🔄 Watching for changes... Press Ctrl+C to stop, then run: pnpm run build && pnpm run start'",
    "prepare": "pnpm run build:renderer",
    "build": "run-s build:renderer build:tauri build:chmod",
    "build:tauri": "cargo tauri build",
    "build:chmod": "chmod +x \"src-tauri/target/release/bundle/appimage/MatchLock Prep App_0.0.0_amd64.AppImage\"",
    "build:renderer": "rimraf ./dist && tsc -b && vite build",
    "start": "\"./src-tauri/target/release/bundle/appimage/MatchLock Prep App_0.0.0_amd64.AppImage\"",
    "lint": "eslint .",
    "preview": "vite preview"
  },
  "dependencies": {
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/language": "^6.12.4",
    "@codemirror/legacy-modes": "^6.5.2",
    "@codemirror/state": "^6.6.0",
    "@roster-lock/config-editor-gui": "workspace:*",
    "@roster-lock/shared": "workspace:*",
    "@roster-lock/utils": "workspace:*",
    "@tauri-apps/api": "^2.9.1",
    "@tauri-apps/plugin-dialog": "^2.0.0",
    "@tauri-apps/plugin-fs": "^2.0.0",
    "@tauri-apps/plugin-http": "^2.5.9",
    "@tauri-apps/plugin-os": "^2.0.0",
    "@tauri-apps/plugin-shell": "^2.3.3",
    "@uiw/react-codemirror": "^4.25.9",
    "ajv": "^8.20.0",
    "codemirror": "^6.0.2",
    "json-diff-ts": "^4.8.2",
    "path-browserify": "^1.0.1",
    "react": "^19.1.0",
    "react-codemirror-merge": "^4.25.9",
    "react-dom": "^19.1.0",
    "react-markdown": "^10.1.0",
    "react-router": "^7.6.2",
    "react-router-dom": "^7.6.2",
    "react-tooltip": "^5.29.1",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.25.0",
    "@roster-lock/types": "workspace:*",
    "@types/finalhandler": "^1.2.0",
    "@types/node": "^22.0.0",
    "@types/path-browserify": "^1.0.3",
    "@types/react": "^19.1.2",
    "@types/react-dom": "^19.1.2",
    "@vitejs/plugin-react": "^4.4.1",
    "eslint": "^9.25.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.19",
    "globals": "^16.0.0",
    "npm-run-all": "^4.1.5",
    "rimraf": "^6.0.1",
    "rollup-plugin-visualizer": "^7.0.1",
    "tsx": "^4.19.2",
    "typescript": "^7.0.2",
    "typescript-eslint": "^8.30.1",
    "vite": "^6.3.5"
  }
}
