{
  "compilerOptions": {
    "target": "ES2022",
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "types": ["node"],
    "lib": ["es2022"],
    "sourceMap": true,
    "rootDir": "./src",
    "outDir": "./dist",
    "esModuleInterop": true,
    "strict": true,
    "skipLibCheck": true,
    "removeComments": true,
    "noImplicitAny": true
  },
  "files": [
    "src/index.ts",
  ],
  "include": ["./src", "./typings", "./types", "./@types", "**/*.test.ts"],
  "exclude": ["node_modules", "**/*.spec.ts"]
}
