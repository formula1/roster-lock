{
  "name": "@roster-lock/config-editor-cli",
  "version": "0.0.1",
  "description": "A cli tool to build roster lock configs",
  "license": "JSON",
  "author": "Sam Tobia",
  "type": "commonjs",
  "main": "dist/index.js",
  "bin": {
    "rosterlock-config-editor": "dist/index.js"
  },
  "scripts": {
    "prebuild": "node scripts/generate-version.js",
    "build": "rimraf ./dist && tsc",
    "prepare": "pnpm run build",
    "predev": "node scripts/generate-version.js",
    "dev": "tsx src/index.ts",
    "start": "node dist/index.js",
    "test": "vitest run tests/",
    "prebundle": "pnpm run build",
    "bundle": "node scripts/bundle.js",
    "package": "pnpm run bundle && pkg pkg-build/bundle.cjs -t node24-linux-x64 -o bin/rosterlock-config-editor --no-signature"
  },
  "dependencies": {
    "@roster-lock/plugin-runtime": "workspace:*",
    "@roster-lock/shared": "workspace:*",
    "@roster-lock/types": "workspace:*",
    "@roster-lock/utils": "workspace:*",
    "ajv": "^8.17.1",
    "commander": "^14.0.3",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^22.14.1",
    "@yao-pkg/pkg": "^6.19.0",
    "esbuild": "^0.28.1",
    "rimraf": "^6.1.3",
    "tsx": "^4.0.0",
    "typescript": "^5.9.3",
    "vitest": "^4.1.5"
  }
}
