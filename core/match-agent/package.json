{
  "name": "@roster-lock/match-agent",
  "version": "0.3.1",
  "description": "To be used in game to ensure all peices are ready",
  "keywords": [
    "roster-lock",
    "game"
  ],
  "homepage": "https://github.com/formula1/roster-lock#readme",
  "bugs": {
    "url": "https://github.com/formula1/roster-lock/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/formula1/roster-lock.git",
    "directory": "core/match-agent"
  },
  "license": "JSON",
  "author": "Sam Tobia",
  "type": "commonjs",
  "main": "dist/index.js",
  "types": "src/index.ts",
  "publishConfig": {
    "access": "public"
  },
  "bin": {
    "rosterlock-match-agent": "dist/index.js"
  },
  "scripts": {
    "test": "vitest run",
    "build": "rimraf ./dist && tsc && pnpm --filter @roster-lock/match-agent-client run build",
    "prepare": "pnpm run build",
    "dev": "tsx watch src/index.ts listen --dev",
    "start": "node dist/index.js listen"
  },
  "devDependencies": {
    "@roster-lock/dl-archive-tar": "workspace:*",
    "@roster-lock/dl-compression-gzip": "workspace:*",
    "@roster-lock/dl-protocol-http": "workspace:*",
    "@roster-lock/piece-selection-sort-most-used-locally": "workspace:*",
    "@roster-lock/piece-selection-sort-highest-winrate-locally": "workspace:*",
    "@roster-lock/game-launcher-ikemen-go": "workspace:*",
    "@roster-lock/game-launcher-headless": "workspace:*",
    "@roster-lock/match-agent-client": "workspace:*",
    "@roster-lock/relay-conformance": "workspace:*",
    "@roster-lock/relay-server-hosted": "workspace:*",
    "@types/async": "^3.2.25",
    "@types/mime-types": "^2.1.4",
    "@types/node": "^22.14.1",
    "@types/webtorrent": "^0.110.0",
    "@types/ws": "^8.18.1",
    "rimraf": "^6.1.3",
    "tsx": "^4.19.2",
    "typescript": "^7.0.2",
    "vite": "^6.4.3",
    "vitest": "^4.1.5"
  },
  "dependencies": {
    "@roster-lock/plugin-runtime": "workspace:^",
    "@roster-lock/shared": "workspace:*",
    "@roster-lock/types": "workspace:*",
    "@roster-lock/utils": "workspace:*",
    "ajv": "^8.17.1",
    "async": "^3.2.6",
    "commander": "14.0.3",
    "mime-types": "^2.1.35",
    "node-fetch-commonjs": "^3.3.2",
    "path-to-regexp": "^8.3.0",
    "runtypes": "^7.0.4",
    "tar": "^7.4.3",
    "ulid": "^3.0.2",
    "webtorrent": "^2.6.3",
    "ws": "^8.19.0",
    "zod": "^4.3.5"
  }
}
